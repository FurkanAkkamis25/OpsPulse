generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  fcmToken  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  servers Server[]
  agents  Agent[]
}

model Agent {
  id        String    @id @default(cuid())
  name      String
  apiKey    String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastSeen  DateTime?
  createdAt DateTime  @default(now())

  servers Server[]

  @@index([userId])
}

model Server {
  id           String      @id @default(cuid())
  name         String
  url          String
  type         ServerType  @default(EXTERNAL)
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId      String?
  agent        Agent?      @relation(fields: [agentId], references: [id], onDelete: SetNull)
  isActive     Boolean     @default(true)
  threshold    Int?
  healthScore  Float?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  pingLogs PingLog[]
  alerts   Alert[]

  @@index([userId])
  @@index([agentId])
}

enum ServerType {
  EXTERNAL
  INTERNAL
}

model PingLog {
  id         String   @id @default(cuid())
  serverId   String
  server     Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  latency    Int?     // milliseconds; null if unreachable
  statusCode Int?
  isUp       Boolean
  checkedAt  DateTime @default(now())

  @@index([serverId, checkedAt])
}

model Alert {
  id        String      @id @default(cuid())
  serverId  String
  server    Server      @relation(fields: [serverId], references: [id], onDelete: Cascade)
  type      AlertType
  message   String
  sentAt    DateTime    @default(now())

  @@index([serverId])
}

enum AlertType {
  DOWN
  RECOVERED
  THRESHOLD_BREACH
  PREDICTED_FAILURE
}
